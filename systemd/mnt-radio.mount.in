# Generated by install.sh. Edit /etc/systemd/system/mnt-radio.mount, then:
#   sudo systemctl daemon-reload && sudo systemctl restart mnt-radio.automount
[Unit]
Description=Music share for RadioPlayer
After=network-online.target
Wants=network-online.target

[Mount]
What=//@SMB_HOST@/@SMB_SHARE@
Where=/mnt/radio
Type=cifs
# ro: the player never writes to the share.
# soft + echo_interval: if the server goes away, reads fail after a few
#   seconds instead of hanging the player, and the engine falls back to the
#   local emergency folder.
Options=credentials=/etc/radioplayer/smb-credentials,ro,uid=radioplayer,gid=radioplayer,file_mode=0444,dir_mode=0555,iocharset=utf8,vers=@SMB_VERS@,soft,echo_interval=10,actimeo=30,_netdev,nofail
TimeoutSec=30
